#include <windows.h>

/* 热逻辑脚本：点击 F5 会优先读 exe 同目录的 hot.lua，没有就读这一份 */
1001 RCDATA "lua/hot.lua"

/* Tcl/Tk 控制面板：UI 脚本 + 运行时归档（DLL + tcl8.6/tk8.6 脚本树） */
1002 RCDATA "ui/panel.tcl"
1003 RCDATA "build/gen/tcltk.bin"

/* DPI 感知 + Win10 兼容 */
1 24 "src/res/app.manifest"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Double Pendulum Phase Space"
      VALUE "FileVersion", "1.0.0.0"
      VALUE "InternalName", "dp-phase"
      VALUE "OriginalFilename", "dp-phase.exe"
      VALUE "ProductName", "Double Pendulum Phase Space"
      VALUE "ProductVersion", "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
